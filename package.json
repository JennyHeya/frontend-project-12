{
    "name": "@hexlet/code",
    "version": "1.0.0",
    "description": "[![Actions Status](https://github.com/JennyHeya/frontend-project-12/actions/workflows/hexlet-check.yml/badge.svg)](https://github.com/JennyHeya/frontend-project-12/actions)",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "https://github.com/JennyHeya/frontend-project-12.git"
    },
    "license": "ISC",
    "author": "JennyHeya",
    "scripts": {
        "server": "node ./node_modules/@hexlet/chat-server/bin/index.js -s ./frontend/dist",
        "frontend": "cd frontend/ && npm run dev",
        "start:all": "concurrently \"npm run server\" \"npm run frontend\"",
        "build": "cd frontend/ && npm install && npm run build",
        "start": "node ./node_modules/@hexlet/chat-server/bin/index.js -s ./frontend/dist",
        "dev": "concurrently \"npm run dev --prefix frontend\" \"npm run start\""
    },
    "dependencies": {
        "@hexlet/chat-server": "^2.0.4",
        "concurrently": "^9.1.2"
    },
    "resolutions": {
        "fast-uri": "^3.0.3"
    }
}
